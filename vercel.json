{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/listing-uploads/:path*",
      "destination": "/api/listing-uploads/:path*"
    },
    {
      "source": "/drops-uploads/:path*",
      "destination": "/api/drops-uploads/:path*"
    },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/[[...slug]].js": {
      "maxDuration": 60,
      "regions": ["syd1"]
    }
  }
}
